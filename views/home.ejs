<%- include('partials/header', { title: 'Acasă' }) %>
<section class="hero">
  <div class="container">
    <h1>Evenimente memorabile cu Vali</h1>
    <p class="sub">Descoperă următoarele evenimente și alătură-te comunității.</p>
    <div class="cta-row" style="margin-top:16px;">
      <a class="btn-primary" href="/evenimente">Vezi toate evenimentele</a>
      <a class="btn-secondary" href="#newsletter">Abonează-te la noutăți</a>
    </div>
  </div>
  </section>

<section class="container" style="margin-top:24px;">
  <h2>Următoarele evenimente</h2>
  <div id="next-events" class="grid"></div>
</section>

<section class="container" style="margin-top:24px;">
  <h2>Evenimente reușite</h2>
  <div id="past-events" class="grid"></div>
</section>

<section class="container" id="newsletter" style="margin-top:24px;">
  <h2>Abonează-te la noutăți</h2>
  <form id="newsletter-form">
    <input type="email" name="email" placeholder="Email" required style="padding:10px;border-radius:8px;border:1px solid #ddd;"> 
    <button class="btn-primary" type="submit">Abonează-mă</button>
  </form>
</section>

<script>
  async function renderNextEvents() {
    const res = await fetch('/api/events?status=UPCOMING&pageSize=3');
    const { items } = await res.json();
    const root = document.getElementById('next-events');
    root.innerHTML = items.map(e => `
      <div class="card">
        <img src="${(e.images?.[0]?.url)||'/images/placeholder.jpg'}" alt="${e.title}" style="width:100%;height:160px;object-fit:cover;border-radius:8px;"/>
        <h3>${e.title}</h3>
        <p>${new Date(e.startDate).toLocaleDateString('ro-RO')} · ${e.location}</p>
        <div class="cta-row">
          <a class="btn-secondary" href="/evenimente/${e.id}" onclick="track(${e.id}, 'click_details')">Vezi detalii</a>
          <a class="btn-primary" href="/evenimente/${e.id}#inscriere" onclick="track(${e.id}, 'click_participate')">Participă</a>
        </div>
      </div>
    `).join('');
  }
  async function renderPastEvents() {
    const res = await fetch('/api/events?status=EXPIRED&pageSize=3');
    const { items } = await res.json();
    const root = document.getElementById('past-events');
    root.innerHTML = items.map(e => `
      <div class="card">
        <img src="${(e.images?.[0]?.url)||'/images/placeholder.jpg'}" alt="${e.title}" style="width:100%;height:160px;object-fit:cover;border-radius:8px;"/>
        <h3>${e.title}</h3>
        <p>${e.category}</p>
      </div>
    `).join('');
  }
  async function track(id, type) {
    try { await fetch(`/api/events/${id}/track`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ type }) }); } catch(e) {}
  }
  document.getElementById('newsletter-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    alert('Mulțumim! Vei primi în curând noutăți.');
  });
  renderNextEvents();
  renderPastEvents();
</script>
<%- include('partials/footer') %>
