<%- include('partials/header', { title: 'Contact' }) %>
<section class="container" style="margin-top:24px;">
  <h1>Contact</h1>
  <div class="card">
    <form>
      <input type="text" placeholder="Nume" required style="padding:10px;border-radius:8px;border:1px solid #ddd;">
      <input type="email" placeholder="Email" required style="padding:10px;border-radius:8px;border:1px solid #ddd;">
      <textarea placeholder="Mesaj" required style="padding:10px;border-radius:8px;border:1px solid #ddd;width:100%;height:120px;"></textarea>
      <button class="btn-primary" type="submit">Trimite</button>
    </form>
  </div>
  <div style="margin-top:16px;">
    <h2>Locație</h2>
    <div class="card" style="height:300px; display:flex; align-items:center; justify-content:center;">Hartă (placeholder)</div>
    <p>Email: contact@vali-events.local</p>
    <p>Telefon: +40 7xx xxx xxx</p>
  </div>
</section>
<%- include('partials/footer') %>

