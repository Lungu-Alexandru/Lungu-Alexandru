<%- include('../partials/header', { title: 'Blog' }) %>
<section class="container" style="margin-top:24px;">
  <h1>Blog / Noutăți</h1>
  <div class="grid">
    <% posts.forEach(p => { %>
      <article class="card">
        <img src="<%= (p.images?.[0]?.url)||'/images/placeholder.jpg' %>" alt="<%= p.title %>" style="width:100%;height:160px;object-fit:cover;border-radius:8px;"/>
        <h3><%= p.title %></h3>
        <p style="opacity:.8"><%= new Date(p.publishedAt).toLocaleDateString('ro-RO') %></p>
        <p><%= p.content.substring(0, 140) %>...</p>
      </article>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %>

