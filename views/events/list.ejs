<%- include('../partials/header', { title: 'Evenimente' }) %>
<section class="container" style="margin-top:24px;">
  <h1>Evenimente viitoare</h1>
  <form id="filters" style="display:flex; gap:12px; flex-wrap:wrap; margin: 12px 0;">
    <input type="text" name="q" placeholder="Caută..." style="padding:10px;border-radius:8px;border:1px solid #ddd;">
    <input type="text" name="category" placeholder="Categorie" style="padding:10px;border-radius:8px;border:1px solid #ddd;">
    <input type="text" name="location" placeholder="Locație" style="padding:10px;border-radius:8px;border:1px solid #ddd;">
    <select name="view" style="padding:10px;border-radius:8px;border:1px solid #ddd;">
      <option value="grid">Grid</option>
      <option value="list">Listă</option>
    </select>
  </form>
  <div id="events" class="grid"></div>
</section>
<script>
  const root = document.getElementById('events');
  async function load() {
    const form = new FormData(document.getElementById('filters'));
    const params = new URLSearchParams(form);
    params.append('status','UPCOMING');
    const res = await fetch('/api/events?' + params.toString());
    const { items, view } = await res.json();
    root.className = view === 'grid' ? 'grid' : '';
    root.innerHTML = items.map(e => view === 'grid' ? gridCard(e) : listItem(e)).join('');
  }
  function gridCard(e){
    return `<div class="card">
      <img src="${(e.images?.[0]?.url)||'/images/placeholder.jpg'}" alt="${e.title}" style="width:100%;height:160px;object-fit:cover;border-radius:8px;"/>
      <h3>${e.title}</h3>
      <p>${new Date(e.startDate).toLocaleDateString('ro-RO')} · ${e.location}</p>
      <div class="cta-row">
        <a class="btn-secondary" href="/evenimente/${e.id}" onclick="track(${e.id}, 'click_details')">Vezi detalii</a>
        <a class="btn-primary" href="/evenimente/${e.id}#inscriere" onclick="track(${e.id}, 'click_participate')">Participă</a>
      </div>
    </div>`
  }
  function listItem(e){
    return `<div style="display:flex; gap:16px; align-items:center; padding:12px; background:#fff; border-radius:12px; margin-bottom:12px;">
      <img src="${(e.images?.[0]?.url)||'/images/placeholder.jpg'}" alt="${e.title}" style="width:120px;height:80px;object-fit:cover;border-radius:8px;"/>
      <div style="flex:1;">
        <h3 style="margin:0;">${e.title}</h3>
        <p style="margin:4px 0;">${new Date(e.startDate).toLocaleDateString('ro-RO')} · ${e.location}</p>
      </div>
      <div class="cta-row"><a class="btn-secondary" href="/evenimente/${e.id}">Detalii</a></div>
    </div>`
  }
  async function track(id, type) {
    try { await fetch(`/api/events/${id}/track`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ type }) }); } catch(e) {}
  }
  document.getElementById('filters').addEventListener('input', load);
  load();
</script>
<%- include('../partials/footer') %>

