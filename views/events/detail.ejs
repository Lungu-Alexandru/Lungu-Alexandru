<%- include('../partials/header', { title: event.title }) %>
<section class="container" style="margin-top:24px;">
  <div class="card" style="padding:24px;">
    <div style="display:grid; grid-template-columns: 1fr; gap:16px;">
      <img src="<%= (event.images?.[0]?.url)||'/images/placeholder.jpg' %>" alt="<%= event.title %>" style="width:100%;max-height:380px;object-fit:cover;border-radius:12px;"/>
      <div>
        <h1><%= event.title %></h1>
        <p><strong>Data:</strong> <%= new Date(event.startDate).toLocaleString('ro-RO') %></p>
        <p><strong>Locație:</strong> <%= event.location %></p>
        <p><%= event.description %></p>
        <div class="cta-row">
          <a class="btn-secondary" href="#inscriere" onclick="track(<%= event.id %>, 'click_details')">Vezi detalii</a>
          <a class="btn-primary" href="#bilete" onclick="track(<%= event.id %>, 'click_participate')">Cumpără bilet</a>
        </div>
      </div>
    </div>
  </div>

  <div class="card" style="margin-top:16px;">
    <h2 id="galerie">Galerie</h2>
    <div class="grid">
      <% (event.galleries || []).forEach(g => { %>
        <div><img src="<%= g.url %>" style="width:100%; height:180px; object-fit:cover; border-radius:12px;"></div>
      <% }) %>
    </div>
  </div>

  <div class="card" id="inscriere" style="margin-top:16px;">
    <h2>Înscriere rapidă</h2>
    <form id="reg-form">
      <input type="text" name="name" placeholder="Nume" required style="padding:10px;border-radius:8px;border:1px solid #ddd;">
      <input type="email" name="email" placeholder="Email" required style="padding:10px;border-radius:8px;border:1px solid #ddd;">
      <button class="btn-primary" type="submit">Înscrie-mă</button>
    </form>
  </div>

  <div class="card" id="bilete" style="margin-top:16px;">
    <h2>Cumpără bilet</h2>
    <form id="pay-form">
      <input type="number" name="amount" placeholder="Suma (RON)" required min="10" step="1" style="padding:10px;border-radius:8px;border:1px solid #ddd;">
      <button class="btn-secondary" type="submit">Plătește cu Revolut</button>
    </form>
  </div>
</section>

<script>
  let registrationId = null;
  const eventId = <%= event.id %>;
  document.getElementById('reg-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = new FormData(e.target);
    const payload = Object.fromEntries(form.entries());
    const res = await fetch(`/api/events/${eventId}/register`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const data = await res.json();
    registrationId = data.registrationId;
    alert('Înscriere reușită! Poți continua la plată.');
  });
  document.getElementById('pay-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!registrationId) { alert('Te rugăm să te înscrii înainte de plată.'); return; }
    const form = new FormData(e.target);
    const payload = Object.fromEntries(form.entries());
    payload.amount = Number(payload.amount) * 100;
    const res = await fetch(`/api/payments/${registrationId}/revolut`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const data = await res.json();
    alert('Plată înregistrată! Vei primi biletul pe email (stub).');
  });
  async function track(id, type) {
    try { await fetch(`/api/events/${id}/track`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ type }) }); } catch(e) {}
  }
</script>

<%- include('../partials/footer') %>

