<%- include('../partials/header', { title: 'Evenimente reușite' }) %>
<section class="container" style="margin-top:24px;">
  <h1>Evenimente reușite</h1>
  <div class="grid">
    <% items.forEach(e => { %>
      <div class="card">
        <img src="<%= (e.images?.[0]?.url)||'/images/placeholder.jpg' %>" alt="<%= e.title %>" style="width:100%;height:160px;object-fit:cover;border-radius:8px;"/>
        <h3><%= e.title %></h3>
        <p><%= e.category %></p>
      </div>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %>

