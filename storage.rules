rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return request.auth.uid != null &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOrganizer() {
      return request.auth.uid != null &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['organizer', 'admin'];
    }
    
    function isValidImageFile() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }
    
    function isValidVideoFile() {
      return request.resource.contentType.matches('video/.*') &&
             request.resource.size < 100 * 1024 * 1024; // 100MB limit
    }
    
    function isValidDocumentFile() {
      return request.resource.contentType in ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'] &&
             request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // User profile images
    match /users/{userId}/profile/{imageId} {
      allow read: if true; // Profile images are public
      allow write: if isOwner(userId) && isValidImageFile();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Event images
    match /events/{eventId}/images/{imageId} {
      allow read: if true; // Event images are public
      allow write: if isOrganizer() && isValidImageFile();
      allow delete: if isOrganizer() || isAdmin();
    }

    // Event videos
    match /events/{eventId}/videos/{videoId} {
      allow read: if true; // Event videos are public
      allow write: if isOrganizer() && isValidVideoFile();
      allow delete: if isOrganizer() || isAdmin();
    }

    // Event promotion materials
    match /events/{eventId}/promotions/{promotionId}/{fileId} {
      allow read: if true; // Promotion materials are public
      allow write: if isOrganizer() && (isValidImageFile() || isValidVideoFile());
      allow delete: if isOrganizer() || isAdmin();
    }

    // Venue images
    match /venues/{venueId}/images/{imageId} {
      allow read: if true; // Venue images are public
      allow write: if isOrganizer() && isValidImageFile();
      allow delete: if isOrganizer() || isAdmin();
    }

    // QR codes for tickets
    match /tickets/{ticketId}/qr/{qrId} {
      allow read: if isAuthenticated(); // Only authenticated users can view QR codes
      allow write: if false; // QR codes are generated server-side only
      allow delete: if isAdmin();
    }

    // Invoice PDFs
    match /invoices/{userId}/{invoiceId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Invoices are generated server-side only
      allow delete: if isAdmin();
    }

    // Organizer documents (for verification)
    match /organizers/{userId}/documents/{documentId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isValidDocumentFile();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Support ticket attachments
    match /support/{ticketId}/attachments/{attachmentId} {
      allow read: if isAuthenticated(); // Support team and user can read
      allow write: if isAuthenticated() && (isValidImageFile() || isValidDocumentFile());
      allow delete: if isAdmin();
    }

    // Temporary uploads (for processing)
    match /temp/{userId}/{fileId} {
      allow read, write: if isOwner(userId) && (isValidImageFile() || isValidVideoFile() || isValidDocumentFile());
      allow delete: if isOwner(userId) || isAdmin();
    }

    // System assets (logos, banners, etc.)
    match /system/{assetId} {
      allow read: if true; // System assets are public
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Backup files (admin only)
    match /backups/{backupId} {
      allow read, write: if isAdmin();
    }

    // Analytics exports
    match /exports/{exportId} {
      allow read: if isOrganizer() || isAdmin();
      allow write: if false; // Exports are generated server-side
      allow delete: if isAdmin();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}